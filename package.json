{
  "name": "ppogg",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "deploy": "nuxt build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply ppogg --remote",
    "db:migrate:local": "wrangler d1 migrations apply ppogg --local"
  },
  "dependencies": {
    "@nuxtjs/mdc": "^0.23.2",
    "jose": "^6.2.15",
    "nuxt": "^4.0.0",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.4.4",
    "@nuxt/fonts": "^1.2.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.156.2"
  },
  "overrides": {
    "@vue/compiler-sfc": {
      "magic-string": "0.30.21"
    }
  }
}
